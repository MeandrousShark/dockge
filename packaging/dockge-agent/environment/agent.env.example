# Install as /etc/dockge/agent.env with owner root:root and mode 0600.
# Replace every REPLACE value before activation. Do not put a raw service token here.
DOCKGE_HOSTNAME=REPLACE_WITH_TAILSCALE_IPV4
DOCKGE_PORT=5001
DOCKGE_DATA_DIR=/var/lib/dockge-agent/data
DOCKGE_STACKS_DIR=/var/lib/dockge-agent/stacks
DOCKGE_CONTAINER_ENGINE=podman
DOCKGE_CONTAINER_ENGINE_SOCKET=unix:///run/podman/podman.sock
DOCKGE_AGENT_ONLY=true
DOCKGE_AGENT_ENDPOINT_ID=REPLACE_WITH_TAILSCALE_IPV4:5001
DOCKGE_AGENT_TOKEN_SHA256=REPLACE_WITH_64_LOWERCASE_HEX_DIGEST
DOCKGE_ENABLE_CONSOLE=false
